{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com; connect-src 'self' https://api.foundersystems.in https://n8n.foundersystems.in https://promptdeck.foundersystems.in; frame-src https://checkout.razorpay.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/index.json",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/products/:product.json",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/products/:product",
      "permanent": false
    },
    {
      "source": "/product-data/index.json",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/product-data/:product.json",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/products/:product",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/tools/promptdeck",
      "destination": "/tools/promptdeck/index.html"
    },
    {
      "source": "/tools/promptdeck/(.*)",
      "destination": "/tools/promptdeck/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "LinkedIn Candidate Screener",
  "version": "0.1.0",
  "description": "Open a LinkedIn profile, add the role, and get recruiter-ready candidate notes.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://foundersystems.in/*",
    "http://127.0.0.1:4173/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["profileExtractor.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Candidate Screener",
    "default_popup": "popup.html"
  }
}

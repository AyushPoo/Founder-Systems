{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:sitemap",
    "build": "vite build",
    "postbuild": "npm run generate:route-shells",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:route-shells": "node scripts/route-seo-shells.mjs",
    "generate:non-financial-thumbnails": "node scripts/render-non-financial-thumbnails.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "test:founder-update": "node src/utils/founderUpdateGenerator.test.js && node api/founder-update-generate.test.js",
    "test:document-intelligence-workspace": "node src/utils/founderDocumentIntelligence.test.js && node src/utils/founderDocumentWorkspace.test.js",
    "test:pdf-summary": "node src/utils/founderPdfSummary.test.js && node api/founder-pdf-summarize.test.js",
    "test:safe-explainer": "node src/utils/founderSafeExplainer.test.js && node api/founder-safe-explainer.test.js",
    "test:document-intelligence": "npm run test:document-intelligence-workspace && npm run test:pdf-summary && npm run test:safe-explainer",
    "test:founder-copilot": "node src/utils/founderCopilotSession.test.js",
    "test:linkedin-candidate-screener": "node shared/linkedinCandidateScreener.test.js && node api/linkedin-candidate-screener.test.js && node extensions/linkedin-candidate-screener/profileExtractor.test.js && node extensions/linkedin-candidate-screener/release-docs.test.js && node src/components/linkedin-candidate-screener/catalog.test.js",
    "test:founder-command-center": "node src/utils/founderCommandCenterMemory.test.js && node src/utils/founderCommandCenterIngest.test.js && node api/founder-command-center-ingest.test.js && node src/components/founder-command-center/catalog.test.js && node src/utils/workspaceMemory.test.js",
    "test:account-settings": "node src/utils/accountSections.test.js && node src/components/account/AccountSettingsShell.test.js && node src/components/account/ConnectionsPanel.test.js",
    "test:thumbnail-refresh": "node scripts/verify-non-financial-thumbnails.mjs",
    "test:route-seo-shells": "node scripts/route-seo-shells.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  }
}
